{
  "name": "euvsimulator",
  "version": "1.0.3",
  "description": "euvsimulator — Physics-accurate EUV lithography simulator. Provides tools for single simulation, process window analysis, and resist parameter calibration from wafer data.",
  "homepage": "https://github.com/Flowbudget/euvsimulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flowbudget/euvsimulator.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Florian Scheide",
    "url": "https://github.com/Flowbudget"
  },
  "keywords": [
    "euv",
    "lithography",
    "simulation",
    "physics",
    "semiconductor",
    "photolithography",
    "resist",
    "process-window",
    "calibration"
  ],
  "mcp": {
    "version": "1.0.0",
    "server": {
      "name": "euvsimulator",
      "version": "1.0.3",
      "description": "EUV lithography simulation tools",
      "capabilities": {
        "tools": true,
        "resources": false,
        "prompts": false
      }
    },
    "tools": [
      {
        "name": "simulate",
        "description": "Run a single EUV lithography simulation with specified parameters. Returns CD, NILS, LER/LWR, aerial image, and resist profile.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period_nm": { "type": "number", "description": "Grating period in nm", "default": 64.0 },
            "line_width_nm": { "type": "number", "description": "Line width in nm", "default": 32.0 },
            "dose_mj_cm2": { "type": "number", "description": "Dose in mJ/cm²", "default": 20.0 },
            "na": { "type": "number", "description": "Numerical aperture", "default": 0.33 },
            "sigma": { "type": "number", "description": "Coherence factor (partial coherence)", "default": 0.8 },
            "illumination_shape": { "type": "string", "enum": ["conventional", "annular", "quadrupole", "dipole"], "default": "conventional" },
            "se_blur_nm": { "type": "number", "description": "Secondary electron blur in nm", "default": 5.0 },
            "resist_model": { "type": "string", "enum": ["aerial_threshold", "full_chem", "stochastic"], "default": "full_chem" },
            "grid": { "type": "integer", "description": "Simulation grid size (power of 2)", "default": 256 },
            "focus_nm": { "type": "number", "description": "Defocus in nm", "default": 0.0 },
            "include_aerial": { "type": "boolean", "description": "Include aerial image in output", "default": false },
            "include_resist": { "type": "boolean", "description": "Include resist profile in output", "default": false }
          },
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "cd_nm": { "type": "number" },
            "nils": { "type": "number" },
            "ler_nm": { "type": ["number", "null"] },
            "lwr_nm": { "type": ["number", "null"] },
            "status": { "type": "string", "enum": ["success", "failed", "nan_slice"] },
            "aerial_image": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
            "resist_profile": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
            "metadata": { "type": "object" }
          }
        }
      },
      {
        "name": "process_window",
        "description": "Generate process window (Bossung curves) with CD and NILS heatmaps across focus and dose ranges. Returns matrices, DoF/EL metrics, and optional PNG/CSV exports.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "period_nm": { "type": "number", "default": 64.0 },
            "line_width_nm": { "type": "number", "default": 32.0 },
            "dose_mj_cm2": { "type": "number", "default": 20.0 },
            "na": { "type": "number", "default": 0.33 },
            "sigma": { "type": "number", "default": 0.8 },
            "illumination_shape": { "type": "string", "enum": ["conventional", "annular", "quadrupole", "dipole"], "default": "conventional" },
            "se_blur_nm": { "type": "number", "default": 5.0 },
            "resist_model": { "type": "string", "enum": ["aerial_threshold", "full_chem", "stochastic"], "default": "full_chem" },
            "grid": { "type": "integer", "default": 256 },
            "focus_range_nm": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "default": [-100, 100] },
            "focus_steps": { "type": "integer", "default": 21 },
            "dose_range_mj_cm2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "default": [10, 30] },
            "dose_steps": { "type": "integer", "default": 21 },
            "tolerance": { "type": "number", "description": "CD spec window fraction (e.g., 0.1 = ±10%)", "default": 0.1 },
            "include_plots": { "type": "boolean", "default": true }
          },
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "cd_matrix": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] } } },
            "nils_matrix": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] } } },
            "dof_nm": { "type": ["number", "null"] },
            "el_percent": { "type": ["number", "null"] },
            "cd_heatmap_png_base64": { "type": ["string", "null"] },
            "nils_heatmap_png_base64": { "type": ["string", "null"] },
            "csv_base64": { "type": ["string", "null"] },
            "focus_values_nm": { "type": "array", "items": { "type": "number" } },
            "dose_values_mj_cm2": { "type": "array", "items": { "type": "number" } }
          }
        }
      },
      {
        "name": "calibrate",
        "description": "Calibrate resist parameters from wafer CD measurements using scipy optimization with bootstrap confidence intervals.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "wafer_data_csv_base64": { "type": "string", "description": "Base64-encoded CSV with columns: dose_mj_cm2, focus_nm, cd_nm" },
            "initial_guess": { "type": "object", "description": "Optional initial parameter guess", "properties": {} },
            "bounds": { "type": "string", "enum": ["default", "wide", "tight"], "default": "default" },
            "method": { "type": "string", "enum": ["Nelder-Mead", "L-BFGS-B", "SLSQP"], "default": "Nelder-Mead" },
            "bootstrap_samples": { "type": "integer", "default": 1000 },
            "confidence": { "type": "number", "default": 0.95 }
          },
          "required": ["wafer_data_csv_base64"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "fitted_parameters": {
              "type": "object",
              "properties": {
                "C": { "type": "number" },
                "Q": { "type": "number" },
                "k": { "type": "number" },
                "t_bake": { "type": "number" },
                "sigma_diff": { "type": "number" },
                "R_max": { "type": "number" },
                "R_min": { "type": "number" },
                "n": { "type": "number" },
                "M_th": { "type": "number" }
              }
            },
            "rmse": { "type": "number" },
            "bootstrap_ci": { "type": "object" },
            "covariance": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
          }
        }
      }
    ]
  },
  "installation": {
    "method": "pip",
    "command": "pip install -e git+https://github.com/Flowbudget/euvsimulator.git#egg=euvsimulator",
    "editable": true,
    "dev_extras": "[dev]"
  },
  "entry_points": {
    "console_scripts": [
      "euv = euvsimulator.io.cli:main"
    ]
  }
}